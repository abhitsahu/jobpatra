generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// AUTH MODELS

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  jobTitle           String?
  industry           String?
  role               String    @default("USER")
  razorpayCustomerId String?   @unique

  accounts      Account[]
  resumes       Resume[]
  subscription  Subscription?
  usageTracking UsageTracking[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// RESUME BUILDER MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Resume {
  id           String    @id @default(cuid())
  userId       String
  title        String
  templateId   String    @default("classic-demo")
  status       String    @default("DRAFT") // ResumeStatus enum in TypeScript
  declaration  String?   @db.Text
  sectionOrder String[]  @default([])
  pdfUrl       String?
  s3Key        String?
  deletedAt    DateTime?

  // Relations
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalInfo   PersonalInfo?
  experiences    WorkExperience[]
  education      Education[]
  projects       Project[]
  skills         Skill[]
  certifications Certification[]
  achievements   Achievement[]
  languages      Language[]
  references     Reference[]
  atsAnalyses    ATSAnalysis[]
  aiSuggestions  AISuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deletedAt])
  @@index([userId, status])
  @@map("resumes")
}

model PersonalInfo {
  id       String  @id @default(cuid())
  resumeId String  @unique
  fullName String
  jobTitle String?
  email    String
  phone    String?
  location String?
  website  String?
  linkedin String?
  github   String?
  summary  String? @db.Text

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("personal_info")
}

model WorkExperience {
  id               String   @id @default(cuid())
  resumeId         String
  company          String
  position         String
  location         String?
  startDate        String
  endDate          String?
  currentlyWorking Boolean  @default(false)
  description      String?  @db.Text
  highlights       String[] @default([])
  order            Int      @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, order])
  @@map("work_experiences")
}

model Education {
  id           String  @id @default(cuid())
  resumeId     String
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    String
  endDate      String?
  result       String? // GPA, percentage, grade
  order        Int     @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, order])
  @@map("education")
}

model Project {
  id           String   @id @default(cuid())
  resumeId     String
  title        String
  field        String?
  startDate    String?
  endDate      String?
  description  String?  @db.Text
  technologies String[] @default([])
  link         String?
  order        Int      @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, order])
  @@map("projects")
}

model Skill {
  id       String @id @default(cuid())
  resumeId String
  name     String
  category String @default("TECHNICAL") // SkillCategory enum in TypeScript
  order    Int    @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("skills")
}

model Certification {
  id       String  @id @default(cuid())
  resumeId String
  name     String
  issuer   String?
  date     String?
  url      String?
  order    Int     @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("certifications")
}

model Achievement {
  id          String  @id @default(cuid())
  resumeId    String
  title       String
  date        String?
  description String? @db.Text
  order       Int     @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("achievements")
}

model Language {
  id          String  @id @default(cuid())
  resumeId    String
  name        String
  proficiency String? // LanguageProficiency enum in TypeScript
  order       Int     @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("languages")
}

model Reference {
  id          String  @id @default(cuid())
  resumeId    String
  name        String
  designation String?
  company     String?
  email       String?
  phone       String?
  order       Int     @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("references")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI & ATS MODELS
// ─────────────────────────────────────────────────────────────────────────────

model ATSAnalysis {
  id             String @id @default(cuid())
  resumeId       String
  jobDescription String @db.Text
  overallScore   Int // 0–100
  keywordMatches Json // { matched: string[], missing: string[] }
  suggestions    Json // [{ section, issue, fix }]
  formatScore    Int // 0–100
  contentScore   Int // 0–100

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([resumeId])
  @@map("ats_analyses")
}

model AISuggestion {
  id        String  @id @default(cuid())
  resumeId  String
  section   String // "summary" | "experience" | "skills" | etc.
  original  String  @db.Text
  suggested String  @db.Text
  accepted  Boolean @default(false)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([resumeId])
  @@map("ai_suggestions")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBSCRIPTION & USAGE MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  plan                   String    @default("FREE")    // Plan enum in TypeScript
  status                 String    @default("ACTIVE")  // SubStatus enum in TypeScript
  paymentProvider        String?                        // "razorpay" | "stripe"
  paymentId              String?                        // External subscription ID
  razorpaySubscriptionId String?   @unique
  razorpayStatus         String?
  currentPeriodStart     DateTime  @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model UsageTracking {
  userId        String
  feature       String    // e.g., "RESUME_CREATE", "ATS_ANALYSIS", "AI_SUGGESTION", "DOWNLOAD_PDF"
  used          Int       @default(0)
  lastResetDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, feature])
  @@map("usage_tracking")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRICING MODELS
// ─────────────────────────────────────────────────────────────────────────────

model PricingPlan {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  monthlyPrice            Float
  quarterlyPrice          Float
  quarterlyDiscount       Int      @default(0)   // percentage e.g. 20
  currency                String   @default("USD")
  description             String
  badge                   String?                // "Most Popular" | "Recommended" | null
  badgeColor              String?                // "primary" | "secondary" | null
  buttonText              String
  buttonVariant           String   @default("outline") // "solid" | "outline"
  isPopular               Boolean  @default(false)
  displayOrder            Int      @default(0)
  isActive                Boolean  @default(true)
  razorpayPlanIdMonthly   String?
  razorpayPlanIdQuarterly String?

  limitResumeCreate       Int      @default(3)
  limitAtsAnalysis        Int      @default(1)
  limitAiSuggestion       Int      @default(1)
  limitDownloadPdf        Int      @default(3)

  features PlanFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pricing_plans")
}

model PlanFeature {
  id        String  @id @default(cuid())
  planId    String
  feature   String
  available Boolean @default(true)
  highlight Boolean @default(false)
  order     Int     @default(0)

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, order])
  @@map("plan_features")
}

model ComparisonFeature {
  id     String @id @default(cuid())
  title  String
  values Json   // Record<planSlug, string> — e.g. { "free": "—", "pro": "check", "enterprise": "check" }
  order  Int    @default(0)

  @@map("comparison_features")
}

model Testimonial {
  id          String  @id @default(cuid())
  name        String
  designation String
  company     String?
  image       String?
  review      String  @db.Text
  rating      Int     @default(5) // 1–5
  isActive    Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())

  @@map("testimonials")
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  amount            Float
  currency          String
  status            String   @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}
